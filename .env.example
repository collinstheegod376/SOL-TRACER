# Solscan API Key (Optional / Pro Tier)
SOLSCAN_API_KEY=your_solscan_api_key_here

# Groq AI API Key (Primary Reasoning Engine)
GROQ_API_KEY=your_groq_api_key_here

# Groq Reasoning Models
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_1=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL_2=openai/gpt-oss-20b

# Solana Mainnet Cluster RPC URL
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
