# SolTrace site. Copy to .env.local. Never commit real keys.
# Your local .env and .env.local already have SOLSCAN_API_KEY, DEEPSEEK_API_KEY, and GROQ_API_KEY.

SOLSCAN_API_KEY=
PRIMARY_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_1=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL_2=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# In use on this machine: Helius mainnet in .env.local. Example stays keyless.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

SOLANA_CLUSTER=mainnet-beta

# Must match apps/admin/.env ADMIN_JWT_SECRET.
REBATE_ADMIN_TOKEN=

# On Vercel, paste the JSON array from keys/vault.json. Locally the file is enough.
VAULT_SECRET_KEY=

# Public address of the operator vault.
VAULT_PUBKEY=

# Paste the token mint here. The snapshot only counts sells of this mint.
TOKEN_MINT=

HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
PYTH_SOL_USD_PRICE_ACCOUNT=
JUPITER_PRICE_URL=https://api.jup.ag/price/v2
COINGECKO_PRICE_URL=https://api.coingecko.com/api/v3/simple/price

# Admin secret stays in apps/admin/.env. Do not put ADMIN_JWT_SECRET here.
